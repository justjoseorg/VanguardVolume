<Window x:Class="VanguardVolume.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VanguardVolume.App"
        mc:Ignorable="d"
        Title="Vanguard Volume" Height="260" Width="480"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock FontSize="22" FontWeight="SemiBold" Text="Vanguard Volume"/>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="Map the VANGUARD 96 G1-G6 keys in iCUE/Web Hub to F13-F18. The volume dial controls the selected row; press the dial to mute."/>
        <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="Current mapping"/>
        <TextBlock x:Name="MappingText" Margin="0,6,0,0" FontFamily="Consolas" TextWrapping="Wrap"/>
        <TextBlock Margin="0,16,0,0" Foreground="DimGray" Text="The service remains active when this window is minimized."/>
    </StackPanel>
</Window>
